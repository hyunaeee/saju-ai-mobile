# ===== 서버 환경변수 (Vercel 대시보드 → Settings → Environment Variables 에 등록) =====
# ⚠️ 이 값들은 절대 프론트엔드/깃허브에 커밋하지 마세요. 서버에서만 사용됩니다.

# 토스페이먼츠 시크릿 키 (test_sk_... 로 테스트 → 심사 후 live_sk_... 로 교체)
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# 접근 토큰 서명용 비밀키 — 아무 긴 랜덤 문자열(32자 이상 권장)
# 생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=여기에_길고_랜덤한_문자열

# Claude API 키 (질문 답변 AI용). 미설정 시 템플릿 답변으로 자동 폴백됩니다.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ===== 모임 관계 지도 — 실시간 공동 파티용 저장소 (선택) =====
# Vercel 대시보드 → Storage → Upstash Redis(무료) 연결하면 아래 2개가 자동 주입됩니다.
# 미설정 시 관계 지도는 URL 링크 체인 모드로 동작(친구가 추가하면 새 링크 생성).
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
